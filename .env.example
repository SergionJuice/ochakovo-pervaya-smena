# Скопируйте в .dev.vars для локального Wrangler/Vite.
# В production задавайте значения как серверные Secrets хостинга.
# Не коммитьте заполненный файл. Не используйте NEXT_PUBLIC_*.

# true включает реальное сохранение в D1 при остальных обязательных настройках.
APPLICATIONS_ENABLED=false
# cabinet: только HR-кабинет. email: дополнительно уведомления Resend.
APPLICATION_DELIVERY=cabinet
# Обязательный текст согласия на обработку анкеты; в кавычках при пробелах.
APPLICATION_CONSENT_TEXT=
# Версия текста, сохраняется с каждой заявкой.
APPLICATION_CONSENT_VERSION=
# Обязательный случайный серверный секрет минимум 32 символа.
# Не изменять после установки HR-пароля без процедуры его сброса.
HR_PASSWORD_PEPPER=

# Необязательно: только для APPLICATION_DELIVERY=email.
# Получатель фиксирован на сервере: rabota@ochakovo.ru.
MAIL_PROVIDER=resend
RESEND_API_KEY=
# Подтверждённый отправитель Resend, например Название <sender@your-domain.example>.
MAIL_FROM=
